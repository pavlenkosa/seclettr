{
  "name": "@seclettr/web",
  "version": "1.0.0-beta",
  "private": true,
  "description": "Seclettr web client",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=lcov",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@seclettr/crypto": "workspace:*",
    "@seclettr/protocol": "workspace:*",
    "libsodium-wrappers": "^0.7.13",
    "mediasoup-client": "^3.7.17",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.3",
    "zod": "^3.22.4",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "1.6.1",
    "eslint": "8.57.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "4.6.2",
    "jsdom": "^28.1.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.19.0",
    "vitest": "^1.6.1"
  },
  "license": "Apache-2.0"
}
