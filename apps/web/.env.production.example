# ──────────────────────────────────────────────────────────────────────────────
# Seclettr Web — Production environment variables
#
# Copy this file to .env.production and fill in values before building.
# All variables must be prefixed with VITE_ to be exposed to the browser bundle.
# ──────────────────────────────────────────────────────────────────────────────

# Base URL of the Seclettr API server, as seen from the browser.
# When using a reverse proxy that rewrites /api → backend, leave as default.
# Default: /api
VITE_API_URL=/api

# Base URL of the SFU (Selective Forwarding Unit) for group calls.
# When using a reverse proxy that rewrites /sfu → SFU backend, leave as default.
# Default: /sfu
VITE_SFU_URL=/sfu

# Enable frame-level E2EE for direct (1-to-1) calls using Insertable Streams.
# Requires a browser with WebRTC Encoded Transform support (Chrome 94+, Safari 16.4+).
# Set to "true" to enable; any other value disables it.
# Default: disabled
VITE_ENABLE_DIRECT_CALL_FRAME_E2EE=false
