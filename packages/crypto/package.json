{
  "name": "@seclettr/crypto",
  "version": "1.1.0-beta",
  "private": true,
  "description": "Seclettr crypto messaging protocol",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=lcov",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "libsodium-wrappers-sumo": "0.7.13"
  },
  "devDependencies": {
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@vitest/coverage-v8": "1.6.1",
    "jsdom": "^28.1.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.1"
  },
  "license": "Apache-2.0"
}
