# Dev-only environment (isolated from production stack)
NODE_ENV=development
HOST=127.0.0.1
PORT=3301

# Infra credentials (dev-only)
POSTGRES_PASSWORD=dev_postgres_password
REDIS_PASSWORD=dev_redis_password
JWT_SECRET=dev_jwt_secret_minimum_32_characters

# Metrics endpoint auth (required even in dev — docker compose fails at interpolation time without it)
METRICS_BEARER_TOKEN=dev-metrics-token

# Registration policy for local/dev
ALLOW_PUBLIC_REGISTRATION=true

# Use false for local HTTP development (not LAN or production)
COOKIE_SECURE=false

# TURN (optional for dev-turn profile)
TURN_SECRET=dev_turn_secret_123456
TURN_DOMAIN=127.0.0.1
TURN_EXTERNAL_IP=127.0.0.1
TURN_PORT=53478
TURNS_PORT=55349
TURN_MIN_PORT=55000
TURN_MAX_PORT=55199

# MinIO / S3
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=dev_minio_secret_value
S3_BUCKET=seclettr-attachments
S3_REGION=us-east-1
# S3_PUBLIC_URL — public-facing origin used to rewrite presigned upload URLs
# before returning them to the browser.  Set automatically by dev-up.sh and
# dev-up-lan.sh to route uploads through the Vite HTTPS proxy instead of
# plain HTTP MinIO.  Leave unset when deploying with a real S3 or when MinIO
# is already behind an HTTPS reverse proxy.
# S3_PUBLIC_URL=https://127.0.0.1:5175

# SFU for local dev runner
SFU_URL=http://127.0.0.1:3302
ANNOUNCED_IP=127.0.0.1

# CORS
CORS_ORIGIN=https://localhost:5173,http://localhost:5173,https://127.0.0.1:5173,http://127.0.0.1:5173,https://localhost:5174,http://localhost:5174,https://127.0.0.1:5174,http://127.0.0.1:5174

# Isolated host ports for local infra containers
DEV_POSTGRES_PORT=55432
DEV_REDIS_PORT=56379
DEV_MINIO_API_PORT=59000
DEV_MINIO_CONSOLE_PORT=59001
DEV_TURN_PORT=53478
DEV_TURNS_PORT=55349
DEV_API_PORT=3301
DEV_SFU_PORT=3302
DEV_SFU_RTC_MIN_PORT=47000
DEV_SFU_RTC_MAX_PORT=47049
DEV_WEB_PORT=5175

# Compose host-port mappings used by scripts/dev-up.sh
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
MINIO_API_HOST_PORT=59000
MINIO_CONSOLE_HOST_PORT=59001
API_HOST_PORT=3301
