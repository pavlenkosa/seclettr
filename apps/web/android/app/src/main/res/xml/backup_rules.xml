<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 6–11 Auto Backup exclusion rules.
  Excludes SharedPreferences files that contain sensitive tokens:
  - seclettr_push_state: WS auth token + server URL + use_fcm flag
  - CapacitorStorage: Capacitor Preferences (refresh token, background poll token, server URL)
-->
<full-backup-content>
    <exclude domain="sharedpref" path="seclettr_push_state.xml" />
    <exclude domain="sharedpref" path="CapacitorStorage.xml" />
</full-backup-content>
