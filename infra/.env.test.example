# Seclettr test environment template.
# Copy to infra/.env.test OR generate with scripts/gen-test-env.sh/.ps1

NODE_ENV=test
HOST=127.0.0.1
PORT=3001

POSTGRES_PASSWORD=replace_me
REDIS_PASSWORD=replace_me
JWT_SECRET=replace_with_at_least_32_chars
TURN_SECRET=replace_with_at_least_16_chars
TURN_DOMAIN=localhost
ALLOW_PUBLIC_REGISTRATION=true

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace_me

ANNOUNCED_IP=127.0.0.1
CORS_ORIGIN=http://localhost:5173
NGINX_CONFIG=nginx.http.conf

DATABASE_URL=postgresql://quartz:replace_me@localhost:5432/quartz
REDIS_URL=redis://:replace_me@localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=quartz-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=replace_me
S3_REGION=us-east-1

SFU_URL=http://localhost:3002

# Optional web push test config
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@localhost

API_URL=http://localhost:3001
BASE_URL=http://localhost:5173
