<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ data extraction rules (cloud backup + device-to-device transfer).
  Excludes SharedPreferences files that contain sensitive tokens from both paths.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="seclettr_push_state.xml" />
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="seclettr_push_state.xml" />
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
    </device-transfer>
</data-extraction-rules>
